[configuration]
entry_symbol = "lincity_library_init"
compatibility_minimum = "4.5"

[libraries]
linux.debug = "res://bin/liblincity_godot.so"
linux.release = "res://bin/liblincity_godot.release.so"
windows = "res://bin/liblincity_godot.dll"
macos.debug = "res://bin/liblincity_godot.dylib"
macos.release = "res://bin/liblincity_godot.release.dylib"
